<div style="border:1px solid var(--hairline); border-radius:6px; padding:10px; margin-bottom:8px; font-size:12.5px;">
  <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:8px;">
    <div>
      <strong><%= m.name %></strong>
      <span class="badge <%= m.isActive ? 'badge-active' : 'badge-inactive' %>" style="margin-left:6px;"><%= m.isActive ? 'Bật' : 'Tắt' %></span>
      <br/>
      <span class="mono" style="font-size:11px; color:var(--text-muted); word-break: break-all;">identifier: <%= m.identifier %></span>
      <% if (m.description) { %><br/><span style="font-size:11px; color:var(--text-muted);"><%= m.description %></span><% } %>
      <br/>
      <% if (m.fileUrl) { %>
        <a href="<%= backendOrigin %><%= m.fileUrl %>" target="_blank" style="font-size:11px;">📁 <%= m.originalFileName || 'file' %> (<%= m.sizeMB || '?' %> MB)</a>
      <% } else if (m.downloadUrl) { %>
        <a href="<%= m.downloadUrl %>" target="_blank" style="font-size:11px; word-break: break-all;">🔗 link ngoài</a>
      <% } else { %>
        <span style="font-size:11px; color:var(--text-muted);">— chưa có file —</span>
      <% } %>
    </div>
  </div>
  <div style="display:flex; gap:6px; margin-top:8px;">
    <form class="inline-form" method="POST" action="/languages/models/<%= m._id %>/update">
      <input type="hidden" name="type" value="<%= m.type %>" />
      <input type="hidden" name="name" value="<%= m.name %>" />
      <input type="hidden" name="languageCode" value="<%= m.languageCode %>" />
      <input type="hidden" name="identifier" value="<%= m.identifier %>" />
      <input type="hidden" name="downloadUrl" value="<%= m.downloadUrl || '' %>" />
      <input type="hidden" name="sizeMB" value="<%= m.sizeMB || '' %>" />
      <input type="hidden" name="description" value="<%= m.description || '' %>" />
      <input type="hidden" name="isActive" value="<%= !m.isActive %>" />
      <button type="submit" class="btn btn-ghost btn-sm"><%= m.isActive ? 'Tắt' : 'Bật' %></button>
    </form>
    <form class="inline-form" method="POST" action="/languages/models/<%= m._id %>/delete" onsubmit="return confirm('Xóa model này? File đã upload (nếu có) cũng sẽ bị xóa.');">
      <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
    </form>
    <details style="margin-left:auto;">
      <summary style="cursor:pointer; font-size:11.5px; color:var(--teal);">Sửa / thay file</summary>
      <form method="POST" action="/languages/models/<%= m._id %>/update" enctype="multipart/form-data" style="margin-top:8px; display:flex; flex-direction:column; gap:6px;">
        <input type="hidden" name="type" value="<%= m.type %>" />
        <input type="hidden" name="languageCode" value="<%= m.languageCode %>" />
        <input type="hidden" name="isActive" value="<%= m.isActive %>" />
        <input type="text" name="name" value="<%= m.name %>" placeholder="Tên hiển thị" />
        <input type="text" name="identifier" value="<%= m.identifier %>" placeholder="Identifier" />
        <input type="text" name="downloadUrl" value="<%= m.downloadUrl || '' %>" placeholder="Link tải ngoài" />
        <input type="number" name="sizeMB" value="<%= m.sizeMB || '' %>" placeholder="Kích thước (MB)" />
        <input type="text" name="description" value="<%= m.description || '' %>" placeholder="Ghi chú" />
        <label style="font-size:11px;">Thay file model (bỏ trống nếu giữ nguyên)</label>
        <input type="file" name="modelFile" />
        <button type="submit" class="btn btn-primary btn-sm">Lưu thay đổi</button>
      </form>
    </details>
  </div>
</div>
